# Writes the build date and time (with time zone), git branch and git commit
# to the header OUTPUT, for the About dialog.
#
# Run with cmake -P at every build, not at configure time, so a new commit is
# picked up without reconfiguring.
#
# The header is rewritten only when the source state changes: another commit,
# another branch, or different uncommitted changes to tracked files. A build
# that changes nothing therefore recompiles and relinks nothing, and the date
# recorded is that of the first build of that source state.
#
# Input variables: SOURCE_DIR, OUTPUT, GIT_EXECUTABLE (optional).
#
# Environment variables:
#   SOURCE_DATE_EPOCH        build date for reproducible builds
#                            (https://reproducible-builds.org/specs/source-date-epoch/)
#   WORKRAVE_BUILD_DATETIME  build date text, used as is
#   WORKRAVE_GIT_BRANCH      branch, when the source is not a git tree
#   WORKRAVE_COMMIT_HASH     commit, when the source is not a git tree
#
# Outside a git tree, and without those variables, branch and commit are
# empty and the About dialog does not show them.

cmake_minimum_required(VERSION 3.22)

if(NOT SOURCE_DIR OR NOT OUTPUT)
  message(FATAL_ERROR "BuildInfo.cmake: SOURCE_DIR and OUTPUT must be set")
endif()
if(NOT GIT_EXECUTABLE)
  set(GIT_EXECUTABLE git)
endif()

function(run_git out_var)
  execute_process(
    COMMAND ${GIT_EXECUTABLE} ${ARGN}
    WORKING_DIRECTORY ${SOURCE_DIR}
    OUTPUT_VARIABLE value
    RESULT_VARIABLE result
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET)
  if(result EQUAL 0)
    set(${out_var} "${value}" PARENT_SCOPE)
  else()
    set(${out_var} "" PARENT_SCOPE)
  endif()
endfunction()

# --- branch and commit

set(branch "")
set(commit "")
set(uncommitted "")

run_git(in_git_tree rev-parse --is-inside-work-tree)
if(in_git_tree STREQUAL "true")
  run_git(branch rev-parse --abbrev-ref HEAD)
  if(branch STREQUAL "HEAD")
    set(branch "detached HEAD")
  endif()

  run_git(commit rev-parse --short=10 HEAD)
  if(commit)
    # Changes to tracked files only: untracked files are not part of the source.
    run_git(uncommitted diff HEAD)
    if(uncommitted)
      string(APPEND commit " (modified)")
    endif()
  endif()
endif()

if(DEFINED ENV{WORKRAVE_GIT_BRANCH})
  set(branch "$ENV{WORKRAVE_GIT_BRANCH}")
endif()
if(DEFINED ENV{WORKRAVE_COMMIT_HASH})
  string(SUBSTRING "$ENV{WORKRAVE_COMMIT_HASH}" 0 10 commit)
endif()

# --- has the source state changed since the header was written?

# The uncommitted changes themselves are part of the state, so that further
# edits to an already modified tree count as a change.
string(SHA1 state
  "${branch}\n${commit}\n${uncommitted}\n$ENV{WORKRAVE_BUILD_DATETIME}\n$ENV{SOURCE_DATE_EPOCH}")
set(state_line "// state: ${state}")

if(EXISTS "${OUTPUT}")
  file(STRINGS "${OUTPUT}" recorded_state REGEX "^// state: ")
  if(recorded_state STREQUAL state_line)
    return()
  endif()
endif()

# --- build date

if(DEFINED ENV{WORKRAVE_BUILD_DATETIME})
  set(build_datetime "$ENV{WORKRAVE_BUILD_DATETIME}")
elseif(DEFINED ENV{SOURCE_DATE_EPOCH})
  # string(TIMESTAMP) uses SOURCE_DATE_EPOCH when it is set.
  string(TIMESTAMP build_datetime "%Y-%m-%d %H:%M:%S UTC (+0000)" UTC)
else()
  execute_process(
    COMMAND date "+%Y-%m-%d %H:%M:%S %Z (%z)"
    OUTPUT_VARIABLE build_datetime
    RESULT_VARIABLE result
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET)
  if(NOT result EQUAL 0 OR NOT build_datetime)
    string(TIMESTAMP build_datetime "%Y-%m-%d %H:%M:%S UTC (+0000)" UTC)
  endif()
endif()

# --- write the header

function(c_string out_var value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  set(${out_var} "\"${value}\"" PARENT_SCOPE)
endfunction()

c_string(build_datetime "${build_datetime}")
c_string(branch "${branch}")
c_string(commit "${commit}")

file(WRITE "${OUTPUT}.tmp" "// Generated by cmake/modules/BuildInfo.cmake. Do not edit.
${state_line}
#define WORKRAVE_BUILD_INFO_DATETIME ${build_datetime}
#define WORKRAVE_BUILD_INFO_BRANCH ${branch}
#define WORKRAVE_BUILD_INFO_COMMIT ${commit}
")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
